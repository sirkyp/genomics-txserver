{
  "server": {
    "port": 3000,
    "cors": {
      "origin": true,
      "credentials": true
    }
  },
  "modules": {
    "shl": {
      "enabled": false
    },
    "vcl": {
      "enabled": false
    },
    "xig": {
      "enabled": false
    },
    "packages": {
      "enabled": false
    },
    "registry": {
      "enabled": true,
      "masterUrl": "https://fhir.github.io/ig-registry/tx-servers.json",
      "crawlInterval": 30,
      "timeout": 30000,
      "userAgent": "FHIRsmith-Local/1.0"
    },
    "publisher": {
      "enabled": false
    },
    "npmprojector": {
      "enabled": false
    },
    "token": {
      "enabled": false
    },
    "tx": {
      "enabled": true,
      "librarySource": "./data/library-dev.yml",
      "endpoints": [
        {
          "path": "/tx/r4",
          "fhirVersion": "4.0",
          "context": null
        },
        {
          "path": "/tx/r5",
          "fhirVersion": "5.0",
          "context": null
        }
      ],
      "fallback": {
        "enabled": true,
        "server": "https://tx.fhir.org"
      }
    }
  }
}
